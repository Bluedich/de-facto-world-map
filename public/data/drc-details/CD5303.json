code":"CD53","adm2_pcode":"CD5303","adm3_pcode":"CD530301","health_zone":"Niangara","health_area":"Ekibondo","name_source":"grid3_names:inside","assessments":[0]},"cod-35NPD4967_2":{"kind":"settlement","name":"Gada","lat":3.32729,"lon":28.34789,"population":1303,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":295,"extent_type":"Small Settlement Area","grid3_extent_id":"35NPD4967_2","adm1_pcode":"CD53","adm2_pcode":"CD5303","adm3_pcode":"CD530301","health_zone":"Niangara","health_area":"Arikazi","name_source":"grid3_names:inside","assessments":[0]},"cod-35NPD5495_1":{"kind":"settlement","name":"Mbengu","lat":3.57782,"lon":28.38812,"population":1622,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":372,"extent_type":"Small Settlement Area","grid3_extent_id":"35NPD5495_1","adm1_pcode":"CD53","adm2_pcode":"CD5303","adm3_pcode":"CD530301","health_zone":"Niangara","health_area":"Ekibondo","name_source":"grid3_names:inside","assessments":[0]}},"assessments":[{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"low","basis":"default_state_presence","as_of":"2026-10-01","zone":"Rural villages of Niangara territory (Tapili, Ndingba, Ganga, Babagu, Ekibondo, Makilingbo, Lipombo, Arikazi, Wamba Moke health areas)","evidence":"No recent reports of armed-group control in these rural areas; historic LRA raiding (to c.2014-2016) has ceased, while armed Mbororo herders and poachers cause sporadic insecurity without holding territory. Default state presence assumed.","unit":"CD5303-niangara","run_id":"drc-swarm-1","source_ids":[73,74]},{"controller_id":"cod-fardc","sovereign_id":"cod","status":"dominant","confidence":"low","basis":"inference","as_of":"2026-10-01","zone":"Nambia health area north of Niangara (Faragi), designated Mbororo cantonment site","evidence":"In May 2025 the FARDC Uele operational sector gave Mbororo herders across Haut-Uele an ultimatum to regroup at Nambia (Niangara territory) for cantonment and identification, or face military operations. Assigning the Nambia area to the army is an inference from that order: no report confirms that the cantonment was implemented or that the FARDC holds a permanent post there as of 2026. Armed Mbororo herders (not a catalogued entity) may be present.","unit":"CD5303-niangara","run_id":"drc-swarm-1","presence":[{"entity_id":"cod-pnc","role":"present"}],"source_ids":[71,74,75]},{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"medium","basis":"default_state_presence","as_of":"2026-10-01","zone":"Niangara town (territorial seat; GRID3 Inyama, Gbalia and Wawe localities on both banks of the Uele)","evidence":"Territorial headquarters with functioning state administration and police; FARDC units of the Uele operational sector are present in the territory. No reports of armed-group control of the town in 2025-2026.","unit":"CD5303-niangara","run_id":"drc-swarm-1","presence":[{"entity_id":"cod-fardc","role":"present"}],"source_ids":[71,72,75]}],"sources":{"73":{"url":"https://reports.lracrisistracker.com/en/q1-2014/","title":"LRA Crisis Tracker Q1 2014 report","publisher":"Invisible Children / Resolve","date":"2014-04"},"74":{"url":"https://paxforpeace.nl/wp-content/uploads/sites/2/import/import/insecurity-without-borders-pax-policy-brief-21112019.pdf","title":"Insecurity without borders (policy brief)","publisher":"PAX","date":"2019-11-21"},"71":{"url":"https://actualite.cd/2025/05/12/haut-uele-larmee-veut-cantonner-les-eleveurs-mbororo","title":"Haut-Uele: l'armée veut cantonner les éleveurs Mbororo","publisher":"Actualite.cd","date":"2025-05-12"},"75":{"url":"https://www.congoquotidien.com/2025/05/13/fardc-ultimatum-mbororo-haut-uele-securite/","title":"FARDC lance un ultimatum aux éleveurs Mbororo : cantonnement ou traque militaire dans l'Uele","publisher":"Congo Quotidien","date":"2025-05-13"},"72":{"url":"https://actualite.cd/2025/05/05/haut-uele-le-gouvernement-provincial-appele-rehabiliter-le-centre-dafrique-de-niangara","title":"Haut-Uele : le gouvernement provincial appelé à réhabiliter le centre d'Afrique de Niangara","publisher":"Actualite.cd","date":"2025-05-05"}},"units":{"CD5303-niangara":"Niangara territory (Haut-Uele) is outside the active conflict zones of eastern DRC and no armed group is reported to hold territory there in 2025-2026. Niangara town, the territorial seat on the Uele river, has a permanent PNC and state administration presence with FARDC of the Uele operational sector also stationed in the territory. The main security issues are armed Mbororo herders, poachers and residual banditry; the LRA, which raided the Bangadi-Niangara triangle heavily until c.2014-2016, is no longer reported here. In May 2025 the FARDC ordered Mbororo herders from across Haut-Uele to regroup for cantonment at Nambia in Niangara territory, making the army the main force around that site. Rural villages are assessed by default as under state (PNC) control with low-to-medium confidence."}}