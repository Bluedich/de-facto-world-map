3_pcode":"CD620601","health_zone":"Idjwi","health_area":"Kishenyi","name_source":"grid3_names:health_area","assessments":[0]},"cod-35MQT3160_1":{"kind":"settlement","name":"Bwando","alt_names":"Kabingu","lat":-2.16344,"lon":29.0833,"population":9113,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":3070,"extent_type":"Small Settlement Area","grid3_extent_id":"35MQT3160_1","adm1_pcode":"CD62","adm2_pcode":"CD6206","adm3_pcode":"CD620601","health_zone":"Idjwi","health_area":"Bwando","name_source":"grid3_names:inside","assessments":[0]},"cod-35MQT3362_2":{"kind":"settlement","name":"Buhoro 2","alt_names":"Musana","lat":-2.14551,"lon":29.1029,"population":4581,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":1217,"extent_type":"Small Settlement Area","grid3_extent_id":"35MQT3362_2","adm1_pcode":"CD62","adm2_pcode":"CD6206","adm3_pcode":"CD620601","health_zone":"Idjwi","health_area":"Bwando","name_source":"grid3_names:inside","assessments":[0]},"cod-35MQT3389_1":{"kind":"settlement","name":"Ntaligeza","lat":-1.90693,"lon":29.10144,"population":1571,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":480,"extent_type":"Small Settlement Area","grid3_extent_id":"35MQT3389_1","adm1_pcode":"CD62","adm2_pcode":"CD6206","adm3_pcode":"CD620601","health_zone":"Idjwi","health_area":"Kishenyi","name_source":"grid3_names:inside","assessments":[0]}},"assessments":[{"controller_id":"afc-m23-police","sovereign_id":"afc-m23","status":"dominant","confidence":"medium","basis":"inference","as_of":"2026-10-01","since":"2025-02","zone":"Idjwi island (Idjwi health zone; chefferies of Rubenga/Idjwi-Nord and Ntambuka/Idjwi-Sud): Bugarula, Kishenyi, Bushonga, Mugote, Kintama, Bwando, Kilala and all island settlements and health-area neighbourhoods","evidence":"After M23 took Kavumu and Bukavu in mid-February 2025, the surrounding Lake Kivu basin (Kalehe and Kabare shores) came under AFC/M23, leaving Idjwi cut off from government-held territory; the island is assessed as administered by the AFC/M23 South Kivu authorities and their police, with no reported recapture or significant Wazalendo activity through the reference date. No island-specific source could be retrieved, so control (and its exact start date) is inferred from the surrounding M23-held lake basin.","unit":"CD6206-idjwi","run_id":"drc-swarm-1","presence":[{"entity_id":"afc-m23-arc","role":"present"}],"source_ids":[110,151,152]},{"controller_id":"afc-m23-arc","sovereign_id":"afc-m23","status":"dominant","confidence":"low","basis":"inference","as_of":"2026-10-01","since":"2025-02","zone":"Small islands/lakeshore localities attached to the unit but in Katana and Kalehe health zones: Katabazi and Civumo (Ibindja), Candjo (Iko), Muganzo (Ishovu), Ihoka (Tchofi)","evidence":"These localities lie on small islands (Ibindja, Iko) and the western Lake Kivu shore along the Kalehe-Katana corridor that M23 overran in February 2025 and has held as its Goma-Bukavu axis (assessed ARC-held in the Kabare and Kalehe units); with no locality-specific reporting, control by M23 ARC forces is inferred.","unit":"CD6206-idjwi","run_id":"drc-swarm-1","presence":[{"entity_id":"afc-m23-police","role":"present"}],"source_ids":[110,151,152]}],"sources":{"110":{"url":"https://www.criticalthreats.org/briefs/congo-war-security-review","title":"Congo War Security Review, September 25, 2026","publisher":"Critical Threats Project (AEI/ISW)","date":"2026-09-25"},"151":{"url":"https://www.reuters.com/world/africa/m23-rebels-enter-congos-second-largest-eastern-city-bukavu-2025-02-16/","title":"M23 rebels enter Congo's second-largest eastern city, Bukavu","publisher":"Reuters","date":"2025-02-16"},"152":{"url":"https://www.reuters.com/world/africa/m23-rebels-take-control-airport-near-congos-bukavu-2025-02-14/","title":"M23 rebels take control of airport near Congo's Bukavu","publisher":"Reuters","date":"2025-02-14"}},"units":{"CD6206-idjwi":"Idjwi territory (Idjwi island in Lake Kivu, between the Kalehe/Kabare shore and Rwanda) is assessed as under AFC/M23 authority since the February 2025 capture of Kavumu (14 Feb) and Bukavu (16 Feb), after which the state's security forces lost any supply line to the island, which is reachable only from M23-held shores or Rwanda; AFC/M23 has since appointed its own administration for the South Kivu territories it holds. The island has seen little armed-group activity and is assessed as run by the AFC/M23 administration and police, with ARC fighters present at the lake landings. A few small islands/lakeshore localities attached to the unit but falling in Katana and Kalehe health zones (Ibindja, Iko, Ishovu, Tchofi health areas) lie in the M23-held Kalehe-Katana lakeshore corridor (consistent with the Kabare and Kalehe assessments) and are assessed as held by ARC forces. Note: live web research was unavailable for both the original assessment and the review (search budget exhausted, news sites blocked by the egress proxy); the manner of the 2025 handover on the island (withdrawal vs. surrender) and the exact date are not sourced, and island-specific control is inferred, so confidence is medium at best."}}