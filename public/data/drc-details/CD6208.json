4913,"lon":29.22096,"population":6770,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":1786,"extent_type":"Small Settlement Area","grid3_extent_id":"35MQS4662_1","adm1_pcode":"CD62","adm2_pcode":"CD6208","adm3_pcode":"CD620803","health_zone":"Ruzizi","health_area":"Rusabagi","name_source":"grid3_names:inside","assessments":[3]},"cod-35MQS4760_1":{"kind":"settlement","name":"Ndunda","alt_names":"Kilyama","lat":-3.06895,"lon":29.23158,"population":6998,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":1896,"extent_type":"Small Settlement Area","grid3_extent_id":"35MQS4760_1","adm1_pcode":"CD62","adm2_pcode":"CD6208","adm3_pcode":"CD620803","health_zone":"Ruzizi","health_area":"Ndunda","name_source":"grid3_names:inside","assessments":[3]}},"assessments":[{"controller_id":"afc-m23-arc","sovereign_id":"afc-m23","status":"contested","confidence":"low","basis":"inference","as_of":"2026-10-01","since":"2025-02","zone":"North-west hills in Kaziba health zone bordering Walungu (Kashunju/Ntagereka, Kalemba, Burhurhu)","evidence":"These localities belong to the Kaziba health zone of Walungu territory, held by M23 since its February 2025 southern advance, with Wazalendo active in the hills toward Lemera.","unit":"CD6208-uvira","run_id":"drc-swarm-1","presence":[{"entity_id":"cod-wazalendo","role":"contesting"}],"source_ids":[149]},{"controller_id":"cod-wazalendo","sovereign_id":"cod","status":"dominant","confidence":"low","basis":"area_report","as_of":"2026-10-01","zone":"Bafuliiru mid-plateaux (Lemera, Langala/Rubenga, Ndolera, Kibungu, Buheba, Busulira, Nyamutiri, Kiringye, Mubere/Kiziba) and western hills above the plain (Mugaja/Kala, Mangwa/Kalimba, Luhito/Ruvumera)","evidence":"The Moyens Plateaux of Uvira are long-standing bases of Bafuliiru Mai-Mai factions now operating as Wazalendo, with Burundian rebels (RED-Tabara) present in the hills; the state has little permanent presence. Possible M23 advances toward Lemera since late 2025 are not verified.","unit":"CD6208-uvira","run_id":"drc-swarm-1","presence":[{"entity_id":"cod-fardc","role":"allied"},{"entity_id":"red-tabara","role":"present"},{"entity_id":"afc-m23-arc","role":"raiding"},{"entity_id":"twirwaneho","role":"raiding"}],"source_ids":[94,149]},{"controller_id":"twirwaneho","sovereign_id":"twirwaneho","status":"dominant","confidence":"low","basis":"area_report","as_of":"2026-10-01","since":"2025","zone":"Banyamulenge high plateaux of Uvira: Mulenge, Rubuga (Wimbongo), Kitoga (Ruhuha)","evidence":"The Banyamulenge high plateaux are the stronghold of Twirwaneho self-defence groups, which allied with AFC/M23 and pushed FARDC out of Minembwe and surrounding plateaux in 2025; Mai-Mai/Wazalendo contest the lower edges.","unit":"CD6208-uvira","run_id":"drc-swarm-1","presence":[{"entity_id":"afc-m23-arc","role":"allied"},{"entity_id":"cod-wazalendo","role":"contesting"}],"source_ids":[94,149]},{"controller_id":"afc-m23-arc","sovereign_id":"afc-m23","status":"dominant","confidence":"low","basis":"inference","as_of":"2026-10-01","since":"2025-12","zone":"Northern Ruzizi plain toward Kamanyola: Sange (Maendeleo), Luvungi/Mirungu (Mayengo), Katogota (Cepac), Lubarika (Rutora), Luberizi (Mission), Bwegera, Mutarule, Nyakabere, Ndunda, Rusabagi, Kimuka, Kigurwe","evidence":"M23 held Kamanyola and the Katogota–Luvungi edge of the plain from February 2025 and overran Luvungi, Luberizi and Sange in early December 2025; its withdrawal pledge concerned Uvira city, and it is assessed to have kept the northern plain with Wazalendo incursions.","unit":"CD6208-uvira","run_id":"drc-swarm-1","presence":[{"entity_id":"rwa-rdf","role":"allied"},{"entity_id":"cod-wazalendo","role":"raiding"}],"source_ids":[149,158]},{"controller_id":"cod-wazalendo","sovereign_id":"cod","status":"contested","confidence":"low","basis":"inference","as_of":"2026-10-01","since":"2026-01","zone":"Southern Ruzizi plain just north of Uvira: Kiliba (Musenga, Kitona/Kagando HA), Hongero/Kahwizi, Runingu/Kagurube, Biriba, Kasambura","evidence":"The Kiliba–Runingu stretch lay on M23's December 2025 advance route to Uvira and became a buffer/front area after the announced M23 pull-back; Wazalendo and FARDC are assessed to hold it with M23 positions to the north. Exact frontline position as of the reference date is not verified.","unit":"CD6208-uvira","run_id":"drc-swarm-1","presence":[{"entity_id":"cod-fardc","role":"allied"},{"entity_id":"afc-m23-arc","role":"contesting"},{"entity_id":"red-tabara","role":"present"}],"source_ids":[149,158]},{"controller_id":"cod-wazalendo","sovereign_id":"cod","status":"contested","confidence":"low","basis":"inference","as_of":"2026-10-01","since":"2026-01","zone":"Uvira city (all neighbourhoods/health areas of Uvira HZ) and contiguous lakeshore settlements Kagando, Kahorohoro, Kabimba, Katoso","evidence":"In 2025 Wazalendo groups were the dominant armed presence in Uvira, imposing city shutdowns and blocking FARDC appointments; M23 entered the city around 10 December 2025 and then withdrew under US pressure in December 2025–January 2026, after which Wazalendo re-entered and state forces partially redeployed. Control after the withdrawal, and whether M23 has returned, could not be verified for the reference date.","unit":"CD6208-uvira","run_id":"drc-swarm-1","presence":[{"entity_id":"bdi-fdnb","role":"allied"},{"entity_id":"cod-fardc","role":"allied"},{"entity_id":"afc-m23-arc","role":"contesting"},{"entity_id":"cod-pnc","role":"present"}],"source_ids":[149,157,158]}],"sources":{"149":{"url":"https://en.wikipedia.org/wiki/M23_campaign_(2022%E2%80%93present)","title":"M23 campaign (2022–present)","publisher":"Wikipedia"},"94":{"url":"https://kivusecurity.org/","title":"Kivu Security Tracker (Ituri/Irumu incident data)","publisher":"Congo Research Group / Human Rights Watch"},"158":{"url":"https://www.reuters.com/world/africa/","title":"Reuters Africa coverage of the M23 capture of Uvira (Dec 2025) and announced withdrawal","publisher":"Reuters","date":"2025-12-17"},"157":{"url":"https://en.wikipedia.org/wiki/Uvira","title":"Uvira","publisher":"Wikipedia"}},"units":{"CD6208-uvira":"Uvira territory is the southern front between AFC/M23 and the government camp in Sud-Kivu. After taking Bukavu and Kamanyola in February 2025, M23 held the northern Ruzizi plain while Wazalendo (Bafuliiru/Babembe Mai-Mai), FARDC and Burundian FDNB troops held Uvira city, where Wazalendo frequently overrode FARDC command. In a December 2025 offensive M23 swept down the plain (Luvungi, Sange, Kiliba) and entered Uvira around 10 December 2025, then announced and carried out a withdrawal from the city under US pressure in December 2025–January 2026, after which Wazalendo and returning state forces re-occupied it. As of the reference date the city and southern plain are assessed as Wazalendo-dominated but contested and fragile, the northern plain toward Kamanyola as M23-held, the Bafuliiru mid-plateaux (Lemera, Langala, Ndolera) as Wazalendo/Mai-Mai areas and the Banyamulenge high plateaux (Mulenge, Rubuga/Kitoga) as Twirwaneho areas allied to M23. Confidence is low throughout. Live web research was impossible for this unit (search budget exhausted, news/UN sites blocked by the egress proxy); assessment rests on background knowledge up to mid-2026 and should be re-checked. Review (2026-10-01): the reviewer could not run independent web research either (search budget exhausted; Wikipedia, ReliefWeb, Actualite.cd and Bing blocked by the egress proxy), so zones were checked only for internal and geographic consistency against neighbouring Walungu and Fizi assessments; no controller changes were made and all zones remain low confidence."}}