t_names":"Ndolu 2","lat":-2.09373,"lon":26.33239,"population":1161,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":292,"extent_type":"Small Settlement Area","grid3_extent_id":"35MMT2568_1","adm1_pcode":"CD63","adm2_pcode":"CD6302","adm3_pcode":"CD630201","health_zone":"Kailo","health_area":"Kipakata","name_source":"grid3_names:inside","assessments":[1]},"cod-35MMT4649_1":{"kind":"settlement","name":"Lembe Lembe","lat":-2.26978,"lon":26.51896,"population":1060,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":189,"extent_type":"Small Settlement Area","grid3_extent_id":"35MMT4649_1","adm1_pcode":"CD63","adm2_pcode":"CD6302","adm3_pcode":"CD630201","health_zone":"Kailo","health_area":"Lumembe","name_source":"grid3_names:inside","assessments":[1]}},"assessments":[{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"medium","basis":"default_state_presence","as_of":"2026-10-01","zone":"Kailo centre (Kicha/Kailo 1) and villages on the Kindu-Kalima road and Kindu-Kalemie railway: Nyoka, Kimanga, Kampala, Kasenga/Kibaraka/km villages, Lubelenge (Distingue, 22 Km, 26 Km), Libenga, Elila, Lubao, Katako, Muyengo, Kiswa Kyamba, Mumbuza, Lonioma","evidence":"Territorial seat and road/rail corridor next to the provincial capital Kindu with territorial administration and police posts; no armed group is reported to hold, tax or administer these places. Research could not be performed (tools blocked), so this rests on default state presence.","unit":"CD6302-kailo","run_id":"drc-swarm-1","presence":[{"entity_id":"cod-anr","role":"present"},{"entity_id":"cod-fardc","role":"present"}],"source_ids":[162]},{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"low","basis":"default_state_presence","as_of":"2026-10-01","zone":"Remote northern and western villages: Kipakata, Pont Ulindi, Pembeliba, Lokando, Dingi Pongolo, Kimbulu, Malembo, Bisobe (Kapinda), Lembe Lembe (Lumembe), Fumbeka (Ulangate)","evidence":"Isolated villages far from Kailo centre toward Pangi, Punia and Lubutu, where state presence is thin; no armed-group control is known, but Mai-Mai/Wazalendo groups have historically moved in neighbouring territories and could not be checked. Assumed under thin state police/administrative presence.","unit":"CD6302-kailo","run_id":"drc-swarm-1","presence":[{"entity_id":"cod-fardc","role":"present"}],"source_ids":[162]}],"sources":{"162":{"url":"https://fr.wikipedia.org/wiki/Territoire_de_Kailo","title":"Territoire de Kailo","publisher":"Wikipedia"}},"units":{"CD6302-kailo":"Kailo territory (Maniema) lies west of the eastern Kivu frontlines, between Kindu, Kalima and Pangi, and no armed group is known to hold or administer any part of it. The territorial centre (Kailo/Kicha) and the villages along the Kindu-Kalima road and the Kindu-Kalemie railway (Nyoka, Kampala, Kasenga/km villages, Elila, Lubao) are assessed as under PNC policing with territorial administration, FARDC units in the province occasionally present. Remote villages in the north (Kipakata, Pont Ulindi, Pembeliba, Lokando, Kapinda) and the far west (Ulangate) are assumed under the same thin state presence, with lower confidence because Mai-Mai/Wazalendo-type groups have historically circulated in neighbouring Pangi and Punia. Web research for this unit could not be performed (search budget exhausted and news sites egress-blocked), so the assessment rests on default state presence and background knowledge."}}