ation":1396,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":826,"extent_type":"Small Settlement Area","grid3_extent_id":"35LNH1496_1","adm1_pcode":"CD71","adm2_pcode":"CD7105","adm3_pcode":"CD710502","health_zone":"Kapolowe","health_area":"Mulandi","name_source":"grid3_names:inside","assessments":[0]},"cod-35LNH3271_2":{"kind":"settlement","name":"Kyembe","lat":-11.10896,"lon":27.29993,"population":2841,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":1269,"extent_type":"Small Settlement Area","grid3_extent_id":"35LNH3271_2","adm1_pcode":"CD71","adm2_pcode":"CD7105","adm3_pcode":"CD710502","health_zone":"Kapolowe","health_area":"Kyembe 1","name_source":"grid3_names:inside","assessments":[0]}},"assessments":[{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"medium","basis":"default_state_presence","as_of":"2026-10-01","zone":"Rest of Kambove territory: mining towns near Likasi (Kawama, Lupidi, Kibangu, Ndakata), Kapolowe/Lwisha, Manika, Kilela-Balanda and Panda villages","evidence":"No reported armed-group activity in Kambove territory in 2025-2026; Bakata Katanga incidents were in northern Haut-Katanga and Haut-Lomami. Order assumed kept by PNC posts, mining police and customary chiefs, with crime (road robberies) the main threat.","unit":"CD7105-kambove","run_id":"drc-swarm-1","source_ids":[183,184,185]},{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"high","basis":"specific_report","as_of":"2026-10-01","zone":"Kambove town (territory HQ, mining town)","evidence":"Territory HQ under full state administration with a police headquarters; violence is criminal or mining-related (Nov 2024 miner-police clashes that left four dead and damaged the police HQ; May 2026 killing of a geologist on the Likasi road, followed by a police manhunt). No armed group holds any part of the town.","unit":"CD7105-kambove","run_id":"drc-swarm-1","presence":[{"entity_id":"cod-fardc","role":"present"}],"source_ids":[181,182,183]}],"sources":{"183":{"url":"https://crisis24.garda.com/alerts/2024/04/drc-chinese-national-killed-in-suspected-bandit-attack-near-kakontwe-haut-katanga-province-early-april-1","title":"DRC: Chinese national killed in suspected bandit attack near Kakontwe, Haut-Katanga Province","publisher":"Crisis24","date":"2024-04"},"184":{"url":"https://coi.euaa.europa.eu/administration/france/PLib/2409_COD__Bakata_Katanga_163382_web.pdf","title":"RDC : Bakata Katanga","publisher":"OFPRA / EUAA COI","date":"2024-09"},"185":{"url":"https://globalprotectioncluster.org/sites/default/files/2026-04/rdc_clusterprotection_points_saillants_mars_2026_0.pdf","title":"RDC Cluster Protection – points saillants mars 2026","publisher":"Global Protection Cluster","date":"2026-04"},"181":{"url":"https://actualite.cd/2024/11/14/haut-katanga-quatre-morts-kambove-la-suite-des-altercations-entre-creuseurs-et-policiers","title":"Haut-Katanga : quatre morts à Kambove à la suite des altercations entre creuseurs et policiers","publisher":"Actualite.cd","date":"2024-11-14"},"182":{"url":"https://actualite.cd/2026/05/04/haut-katanga-double-meurtre-sur-la-route-likasi-un-geologue-et-son-chauffeur-abattus-la","title":"Haut-Katanga : double meurtre sur la route Likasi, un géologue et son chauffeur abattus, la police lance une traque","publisher":"Actualite.cd","date":"2026-05-04"}},"units":{"CD7105-kambove":"Kambove territory (Haut-Katanga), the copper-mining belt around Likasi between Lubumbashi and Kolwezi, has no reported territorial armed-group presence. The state controls the whole unit: the PNC keeps order in Kambove town and in the mining towns and villages of Kambove, Kapolowe, Manika, Kilela-Balanda and Panda, with FARDC present in the province. Insecurity is criminal and mining-related: clashes between artisanal miners and police in Kambove (Nov 2024, four dead, police HQ vandalised), armed robberies on the Likasi-Kambove road (2024) and the targeted killing of a geologist and his driver on the Likasi road (May 2026), followed by a police manhunt. Bakata Katanga activity in 2024-2026 was concentrated in northern Haut-Katanga/Haut-Lomami (Mitwaba, Pweto, Bukama, Malemba-Nkulu), not in Kambove."}}