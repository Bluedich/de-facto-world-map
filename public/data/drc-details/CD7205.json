ion":3542,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":922,"extent_type":"Small Settlement Area","grid3_extent_id":"35LJJ8744_1","adm1_pcode":"CD72","adm2_pcode":"CD7205","adm3_pcode":"CD720502","health_zone":"Kasaji","health_area":"Mwenekula","name_source":"grid3_names:inside","assessments":[0]},"cod-35LKJ0339_1":{"kind":"settlement","name":"Kwicheka","alt_names":"Samukula; Samutshanka","lat":-10.48748,"lon":24.28886,"population":1690,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":316,"extent_type":"Small Settlement Area","grid3_extent_id":"35LKJ0339_1","adm1_pcode":"CD72","adm2_pcode":"CD7205","adm3_pcode":"CD720502","health_zone":"Kasaji","health_area":"Lungenda","name_source":"grid3_names:inside","assessments":[0]}},"assessments":[{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"low","basis":"default_state_presence","as_of":"2026-10-01","zone":"Rural villages of Dilolo and Kasaji secteurs","evidence":"Sparsely populated rural area with no reported armed-group activity; state presence through PNC posts and territorial administration, with customary chiefs handling everyday disputes in remote villages.","unit":"CD7205-dilolo","run_id":"drc-swarm-1","presence":[{"entity_id":"customary","role":"present"}],"source_ids":[184]},{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"medium","basis":"default_state_presence","as_of":"2026-10-01","zone":"Towns: Dilolo (Ndumba), Kasaji, Kisenge, Divuma","evidence":"Territorial headquarters, border town and mining/railway towns with state administration; the PNC keeps order with FARDC elements deployed along the Angolan border. No armed-group presence is reported; Mai-Mai/Bakata Katanga activity in 2024-2026 is reported far to the north-east.","unit":"CD7205-dilolo","run_id":"drc-swarm-1","presence":[{"entity_id":"cod-fardc","role":"present"}],"source_ids":[184,195]}],"sources":{"184":{"url":"https://coi.euaa.europa.eu/administration/france/PLib/2409_COD__Bakata_Katanga_163382_web.pdf","title":"RDC : Bakata Katanga","publisher":"OFPRA / EUAA COI","date":"2024-09"},"195":{"url":"https://actualite.cd/2026/09/12/grand-katanga-le-spectre-mai-mai-ressurgit-mitwaba-et-malemba-nkulu-alerte-le","title":"Grand Katanga : le spectre Maï-Maï ressurgit à Mitwaba et Malemba-Nkulu, alerte le gouvernement","publisher":"Actualite.cd","date":"2026-09-12"}},"units":{"CD7205-dilolo":"Dilolo territory in western Lualaba, on the Angolan border and the Benguela/Lobito railway, covers Dilolo town (border post with Luau, Angola), Kasaji, the Kisenge manganese mining town and Divuma, plus rural areas of the Dilolo and Kasaji secteurs. No armed group is known to hold territory in the unit: the state controls it, with the PNC (and border/migration services) keeping order in the towns and FARDC elements posted along the Angolan border. Insecurity is criminal (banditry, smuggling, border incidents) rather than territorial. Bakata Katanga / Mai-Mai activity in 2024-2026 was concentrated far to the north-east (Mitwaba, Malemba-Nkulu, Bukama). Web research was unavailable for this unit (search budget exhausted, fetches blocked), so the assessment rests on default state presence and background knowledge."}}