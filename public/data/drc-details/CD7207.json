population":3578,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":1139,"extent_type":"Small Settlement Area","grid3_extent_id":"34MGS6115_1","adm1_pcode":"CD72","adm2_pcode":"CD7207","adm3_pcode":"CD720701","health_zone":"Kalamba","health_area":"Ruung","name_source":"grid3_names:inside","assessments":[0]}},"assessments":[{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"low","basis":"default_state_presence","as_of":"2026-10-01","zone":"Kalamba secteur / Kalamba and Wikong health zones (Kalamba/Nkand Marundu, Chitazu, Mutomb A Chimbang, Nchakal, Kamwanga, Ruung, Karung, etc.) in the east of the territory toward the Lulua/Kasai-Central border","evidence":"Eastern Kapanga borders the former Kamuina Nsapu areas of Kasai-Central/Lomami, but no militia activity is reported there in 2024-2026. Assessed as default state presence; low confidence for lack of unit-specific reporting.","unit":"CD7207-kapanga","run_id":"drc-swarm-1","source_ids":[195,209]},{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"low","basis":"default_state_presence","as_of":"2026-10-01","zone":"Rural Kapanga health zone villages (Ntita, Panda Mwila, Chibaba, Musevu, Kambundu, Kasa Mayi, Masaka, Samabanda, Rubwiz, Mulambu, Dininga, Ruyemb, Murub, etc.)","evidence":"No reported armed-group activity in rural Kapanga in 2024-2026; the 2017 Kamuina Nsapu spill-over from Kasai has ended and Mai-Mai/Bakata Katanga activity is concentrated far to the east (Mitwaba, Malemba-Nkulu). Assessed as default state (PNC/customary) presence.","unit":"CD7207-kapanga","run_id":"drc-swarm-1","source_ids":[184,195,209]},{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"medium","basis":"inference","as_of":"2026-10-01","zone":"Musumba / Kapanga centre (GRID3 'Chala', Musumba health area), seat of the Mwant Yav and territorial administration","evidence":"Territorial chief town and Lunda royal capital with territorial administration, PNC commissariat and a small FARDC presence; no armed-group control reported since Kamuina Nsapu incursions in 2017 were repelled. Unit-specific recent reporting could not be retrieved (web access blocked).","unit":"CD7207-kapanga","run_id":"drc-swarm-1","presence":[{"entity_id":"cod-fardc","role":"present"}],"source_ids":[208,209]}],"sources":{"195":{"url":"https://actualite.cd/2026/09/12/grand-katanga-le-spectre-mai-mai-ressurgit-mitwaba-et-malemba-nkulu-alerte-le","title":"Grand Katanga : le spectre Maï-Maï ressurgit à Mitwaba et Malemba-Nkulu, alerte le gouvernement","publisher":"Actualite.cd","date":"2026-09-12"},"209":{"url":"https://en.wikipedia.org/wiki/Kamwina_Nsapu_rebellion","title":"Kamwina Nsapu rebellion","publisher":"Wikipedia"},"184":{"url":"https://coi.euaa.europa.eu/administration/france/PLib/2409_COD__Bakata_Katanga_163382_web.pdf","title":"RDC : Bakata Katanga","publisher":"OFPRA / EUAA COI","date":"2024-09"},"208":{"url":"https://en.wikipedia.org/wiki/Kapanga_Territory","title":"Kapanga Territory","publisher":"Wikipedia"}},"units":{"CD7207-kapanga":"Kapanga territory in north-western Lualaba is the heartland of the Lunda kingdom, with Musumba (GRID3 'Chala', ~78,000 people) as seat of the Mwant Yav and territorial centre, and the Kapanga and Kalamba health zones as its rural hinterland. No armed group is known to hold territory in the unit as of 2026: the state controls it, with the PNC keeping order in Musumba/Kapanga and in larger villages alongside customary Lunda authorities. In 2017 the Kamuina Nsapu insurgency spilled over from the Kasai provinces into Kapanga territory (attacks on state symbols, displacement), but it was suppressed and no residual militia control is reported. Insecurity is now mainly criminal and linked to customary/succession disputes. Web research was unavailable for this unit (search budget exhausted, fetches blocked), so confidence is medium for Musumba and low for rural areas."}}