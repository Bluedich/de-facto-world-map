ssments":[1]},"cod-35MKT0682_1":{"kind":"settlement","name":"Bolota","alt_names":"Ikeka","lat":-1.9648,"lon":24.3614,"population":3343,"pop_source":"GRID3 COD population v4.4 (100 m)","building_count":379,"extent_type":"Small Settlement Area","grid3_extent_id":"35MKT0682_1","adm1_pcode":"CD83","adm2_pcode":"CD8307","adm3_pcode":"CD830701","health_zone":"Lomela","health_area":"Bayaya","name_source":"grid3_names:inside","assessments":[1]}},"assessments":[{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"low","basis":"default_state_presence","as_of":"2026-10-01","zone":"Tshudi Loto secteur (Tshudi Loto health zone and western Lomela/Kole health-zone fringes: Mabruki/Loto, Longolongo, Tshudi, Mpombi, Pokaongo etc.)","evidence":"Rural secteur west of Lomela town with sub-commissariat/PNC posts at Loto and chefferie/groupement administration; no armed group activity is known, insecurity being limited to banditry and land/chieftaincy disputes. Live web research was unavailable for this run (search budget exhausted, Wikipedia blocked by egress proxy), so the assessment rests on background knowledge and the default-state-presence rule.","unit":"CD8307-lomela","run_id":"drc-swarm-1"},{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"low","basis":"default_state_presence","as_of":"2026-10-01","zone":"Rural villages of Lomela secteur (Lomela and Omendjadi health zones: Mukumari, Shaie, Ikoto, Lokala, Yombo, Edjola, Diamamba etc.)","evidence":"Remote forest villages along the Lomela river and the Lomela-Lodja/Katako-Kombe axes under thin PNC posts, chefs de groupement and customary authority; no organised armed group is reported to hold or tax localities. Live web research was unavailable for this run (search budget exhausted, Wikipedia blocked by egress proxy), so the assessment rests on background knowledge and the default-state-presence rule.","unit":"CD8307-lomela","run_id":"drc-swarm-1"},{"controller_id":"cod-pnc","sovereign_id":"cod","status":"dominant","confidence":"medium","basis":"default_state_presence","as_of":"2026-10-01","zone":"Lomela town (territorial seat; GRID3 'Tohekele' agglomeration) and adjacent Kalonga, Lomela Pilote health area","evidence":"Lomela is the territorial headquarters with territorial administration, a PNC commissariat, tribunal de paix and small FARDC/ANR presence; no armed group is known to operate in Lomela territory, which lies far from eastern conflict zones and outside the Kasai Kamuina Nsapu theatre. Insecurity is limited to banditry, poaching around Sankuru/Lomami forests and local customary disputes handled by the PNC. Live web research was unavailable for this run (search budget exhausted, Wikipedia blocked by egress proxy), so the assessment rests on background knowledge and the default-state-presence rule.","unit":"CD8307-lomela","run_id":"drc-swarm-1","presence":[{"entity_id":"cod-anr","role":"present"},{"entity_id":"cod-fardc","role":"present"}]}],"sources":{},"units":{"CD8307-lomela":"Lomela territory (Sankuru) consists of Lomela town, the Lomela secteur and the Tshudi Loto secteur, a sparsely populated forest area far from the eastern conflict zones and outside the core Kamuina Nsapu theatre. No armed group is known to control territory; insecurity consists of banditry, poaching and customary/land disputes. All locations are assessed as under ordinary state authority with the PNC as the main permanent force (FARDC and ANR elements in Lomela town). Live web research was unavailable for this run, so confidence is medium for Lomela town and low for rural areas."}}